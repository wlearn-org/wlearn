{
  "private": true,
  "workspaces": [
    "js/*"
  ],
  "scripts": {
    "test": "make test",
    "test:js": "node --test scripts/test-*.js && npm test --workspaces --if-present",
    "test:browser": "npm run test:browser --workspace @wlearn/ensemble && npm run test:browser --workspace @wlearn/automl",
    "test:all": "make test-all",
    "test:py-core": "make test-py-core",
    "test:z3": "make test-z3",
    "test:py": "make test-py",
    "test:ecosystem:task": "node scripts/verify-unified-model-tasks.mjs",
    "test:interop:js": "node fixtures/verify.mjs",
    "test:interop:py": "PYTHONPATH=py python3 -m pytest py/tests/test_compat.py -q",
    "test:interop:py:full": "WLEARN_INTEROP_REQUIRE_ALL=1 PYTHONPATH=py python3 -m pytest py/tests/test_compat.py -q",
    "test:interop:reverse": "node fixtures/verify-py-bundles.mjs",
    "test:interop:reverse:full": "WLEARN_INTEROP_REQUIRE_ALL=1 node fixtures/verify-py-bundles.mjs",
    "test:interop:guards": "node fixtures/test-verify-utils.mjs",
    "test:interop:minimal": "node fixtures/run-interop.mjs --minimal",
    "test:interop:full": "node fixtures/run-interop.mjs --full",
    "test:interop": "npm run test:interop:full",
    "dev:link": "node scripts/link-local-wlearn.js",
    "dev:link:force": "node scripts/link-local-wlearn.js --force",
    "dev:unlink": "node scripts/link-local-wlearn.js --unlink",
    "dev:check": "node scripts/link-local-wlearn.js --check",
    "test:integration": "node --test fixtures/test-*.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "playwright": "^1.60.0",
    "playwright-core": "^1.60.0"
  }
}
