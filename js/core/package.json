{
  "name": "@wlearn/core",
  "version": "0.3.2",
  "description": "Runtime core for wlearn: matrix helpers, bundle format, registry, pipeline",
  "type": "commonjs",
  "main": "src/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src/",
    "index.d.ts",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@wlearn/types": "^0.2.0"
  },
  "scripts": {
    "test": "node --test test/*.js",
    "test:types": "tsc --project test/tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "wlearn",
    "machine-learning",
    "bundle",
    "pipeline",
    "registry"
  ],
  "author": "Anton Zemlyansky",
  "repository": {
    "type": "git",
    "url": "https://github.com/wlearn-org/wlearn.git",
    "directory": "js/core"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "homepage": "https://wlearn.org",
  "bugs": {
    "url": "https://github.com/wlearn-org/wlearn/issues"
  }
}
