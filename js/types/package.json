{
  "name": "@wlearn/types",
  "version": "0.2.0",
  "description": "Type definitions and constants for wlearn",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.js",
    "test:types": "tsc --project test/tsconfig.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "wlearn",
    "machine-learning",
    "types",
    "typescript"
  ],
  "author": "Anton Zemlyansky",
  "repository": {
    "type": "git",
    "url": "https://github.com/wlearn-org/wlearn.git",
    "directory": "js/types"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "homepage": "https://wlearn.org",
  "bugs": {
    "url": "https://github.com/wlearn-org/wlearn/issues"
  }
}
