{
  "name": "@wlearn/sdk",
  "version": "0.3.0",
  "description": "Convenience barrel: re-exports all wlearn model classes, automl, ensemble, pipeline, and core utilities",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@wlearn/core": "^0.3.0",
    "@wlearn/automl": "^0.3.0",
    "@wlearn/ensemble": "^0.3.0",
    "@wlearn/liblinear": "^0.3.0",
    "@wlearn/libsvm": "^0.3.0",
    "@wlearn/xgboost": "^0.3.0",
    "@wlearn/lightgbm": "^0.3.0",
    "@wlearn/nanoflann": "^0.3.0",
    "@wlearn/ebm": "^0.3.0",
    "@wlearn/xlearn": "^0.3.0",
    "@wlearn/stochtree": "^0.3.0",
    "@wlearn/tsetlin": "^0.3.0",
    "@wlearn/nn": "0.3.0",
    "@wlearn/rf": "^0.5.0",
    "@wlearn/gam": "^0.3.0",
    "@wlearn/cluster": "^0.1.1",
    "@wlearn/bo": "^0.2.0",
    "@wlearn/preprocess": "^0.1.0",
    "@wlearn/types": "^0.2.0",
    "@wlearn/basis": "^0.1.0",
    "@wlearn/sym": "^0.1.0",
    "@wlearn/uncertainty": "^0.1.0"
  },
  "peerDependencies": {
    "@wlearn/mitra": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@wlearn/mitra": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.js",
    "test:types": "tsc -p test/tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "wlearn",
    "machine-learning",
    "sdk"
  ],
  "author": "Anton Zemlyansky",
  "repository": {
    "type": "git",
    "url": "https://github.com/wlearn-org/wlearn.git",
    "directory": "js/sdk"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/wlearn-org/wlearn/issues"
  },
  "homepage": "https://wlearn.org",
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
